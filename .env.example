TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=

# Provider controlled cutover; default preserves the existing Twilio service.
NOTIFICATION_PROVIDER=twilio
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Separate random secret, >=32 chars, for salted HMAC OTP storage. Do not rotate with active challenges.
WHATSAPP_OTP_HASH_SECRET=
# Exact approved name:locale pairs; empty means no templates can send.
WHATSAPP_APPROVED_TEMPLATES=
DELIVERY_REMINDER_TIME_IST=21:00
# Preserve the currently configured phone ownership policy.
MANDATORY_PHONE_VERIFICATION=false

# Explicitly drain already queued rows on the former provider during controlled cutover only.
NOTIFICATION_DRAIN_PREVIOUS_PROVIDER=false
